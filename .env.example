NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# For database scripts (migrate/cleanup)
SUPABASE_URL=https://your-project.supabase.co

# Auth/session (set to a long random string)
NEXTAUTH_SECRET=change-me

# Surge SMS/MMS (surge.app)
SURGE_API_KEY=your_surge_api_key
SURGE_ACCOUNT_ID=acct_your_surge_account_id
SURGE_PHONE_NUMBER=+15005550006

# Surge webhook signing secret (from Surge dashboard → Webhooks)
SURGE_WEBHOOK_SECRET=your_surge_webhook_secret

# Public app URL (Surge fetches .vcf from this). Use production URL.
APP_URL=https://your-app.vercel.app

# Development only: override SMS recipient for testing
# SMS_TEST_RECIPIENT_PHONE=+15005550006

# Resend email alerts (sent when Surge message delivery fails)
RESEND_API_KEY=re_your_resend_api_key
ALERT_EMAIL_FROM=alerts@yourdomain.com
ALERT_EMAIL_TO=you@youremail.com
