NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# For database scripts (migrate/cleanup)
SUPABASE_URL=https://your-project.supabase.co

# Auth/session (set to a long random string)
NEXTAUTH_SECRET=change-me

# Bird SMS/MMS (messagebird.com)
# BIRD_ACCESS_KEY: create an Access Policy in Bird dashboard → API Access → Access Policies
# BIRD_WORKSPACE_ID: visible in the Bird dashboard URL (e.g. https://app.bird.com/workspaces/<id>)
# BIRD_CHANNEL_ID: your SMS/MMS channel's UUID from Bird dashboard → Channels
# BIRD_PHONE_NUMBER: your provisioned Bird phone number in E.164 format (e.g. +15005550006)
BIRD_ACCESS_KEY=your_bird_access_key
BIRD_WORKSPACE_ID=your_bird_workspace_id
BIRD_CHANNEL_ID=your_bird_channel_id
BIRD_PHONE_NUMBER=+15005550006

# Public app URL (Bird fetches .vcf from this). Use production URL.
APP_URL=https://your-app.vercel.app

# Development only: override SMS recipient for testing
# SMS_TEST_RECIPIENT_PHONE=+15005550006

# Resend email alerts (sent when Bird message delivery fails)
RESEND_API_KEY=re_your_resend_api_key
ALERT_EMAIL_FROM=alerts@yourdomain.com
ALERT_EMAIL_TO=you@youremail.com
